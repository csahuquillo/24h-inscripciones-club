# Configuración de la aplicación (copiar a /etc/poli24h/env y editar).
# NO subir este fichero con valores reales al repositorio.

# --- Base de datos ---
DB_DSN=mysql:host=127.0.0.1;dbname=poli24h;charset=utf8mb4
DB_USER=poli24h
DB_PASS=CAMBIA_ESTA_CLAVE

# --- Aplicación ---
# Genera APP_KEY con:  openssl rand -hex 32
APP_KEY=CAMBIA_ESTO_openssl_rand_hex_32
APP_ENV=prod
BASE_URL=https://tudominio.example

# --- Correo (AWS SES vía rol de instancia; sin secretos en disco) ---
MAIL_FROM=noreply@tudominio.example
MAIL_FROM_NAME=Tu Club - 24 Horas
AWS_REGION=eu-west-3

# --- Datos del club (responsable del tratamiento, RGPD) ---
CLUB_NOMBRE=Tu Club Deportivo
CLUB_CIF=
CLUB_DOMICILIO=
CLUB_EMAIL=contacto@tuclub.example
CLUB_TELEFONO=

# --- Evento ---
EVENTO_NOMBRE=24 Horas

# Nota: fechas del plazo, precios, niveles y actividades se ajustan en
# src/domain.php (constantes) y migrations/schema.sql (semilla de disciplinas).
